  - kind: 2
    value: "-- 6. Create the Product Table\r

      CREATE TABLE PRODUCT\r

      (PRODUCT_ID INT NOT NULL,\r

      SKU CHAR(8),\r

      BRAND_ID INT,\r

      CATEGORY_ID INT,\r

      MODEL_NAME VARCHAR(50),\r

      UNIT_PRICE DECIMAL(10,2),\r

      MANUFACTURE_LOCATION VARCHAR(30),\r

      PRIMARY KEY (PRODUCT_ID),\r

      FOREIGN KEY (BRAND_ID) REFERENCES BRAND(BRAND_ID),\r

      FOREIGN KEY (CATEGORY_ID) REFERENCES CATEGORY(CATEGORY_ID));\r

      -- Insert into Product Table\r

      insert into Product values(1,'SKU-1001',1,1,'Dell XPS
