cells:
  - kind: 1
    value: "# **Zach's Computers Relational Database**\r

      ___"
    languageId: markdown
  - kind: 2
    value: "/*\r

      --For when running in SQL Developer SET DEFINE OFF;\r

      --View tables in the DB\r

      select * from tab;\r

      --view data in the table\r

      select * from customer;\r

      select * from customer_address;\r

      select * from product;\r

      select * from brand;\r

      select * from category;\r

      select * from supplier;\r

      select * from orders;\r

      select * from order_item;\r

      select * from payment;\r

      select * from warehouse;\r

      select * from shipment;\r

      select * from inventory;\r

      select * from return;\r

      select * from review;\r

      \r

      --Drop Tables:\r

      drop table return;\r

      drop table order_item;\r

      drop table payment;\r

      drop table shipment;\r

      drop table review;\r

      drop table inventory;\r

      drop table orders;\r

      drop table customer_address;\r

      drop table product;\r

      drop table brand;\r

      drop table warehouse;\r

      drop table customer;\r

      drop table supplier;\r

      drop table category;\r

      */"
    languageId: oracle-sql
  - kind: 2
    value: "-- 1. Create the Category Table\r

      CREATE TABLE CATEGORY\r

      (CATEGORY_ID INT NOT NULL ,\r

      CATEGORY_NAME VARCHAR(300),\r

      DESCRIPTION VARCHAR(50),\r

      IS_ACTIVE CHAR(1),\r

      PRIMARY KEY (CATEGORY_ID)) ;\r

      -- Insert into Category Table\r

      insert into Category values(1,'Laptops','Notebook and ultrabook
      computers','T');\r

      insert into Category values(2,'Desktops','Tower and small form factor
      PCs','T');\r

      insert into Category values(3,'Monitors','Standalone displays','T');\r

      insert into Category values(4,'Keyboards & Mice','Input
      peripherals','T');\r

      insert into Category values(5,'Storage','Internal and external
      drives','T');\r

      insert into Category values(6,'Graphics Cards','Dedicated GPUs','T');\r

      insert into Category values(7,'Tablets','Tablet devices','T');\r

      insert into Category values(8,'Headsets','Audio headsets','T');\r

      insert into Category values(9,'Printers','Home and office
      printers','T');\r

      insert into Category values(10,'Accessories','Miscellaneous
      accessories','T');"
    languageId: oracle-sql
  - kind: 2
    value: "-- 2. Create the Supplier Table\r

      CREATE TABLE SUPPLIER\r

      (SUPPLIER_ID INT NOT NULL ,\r

      SUPPLIER_NAME VARCHAR(50) NOT NULL,\r

      CONTACT_NAME VARCHAR(30),\r

      CONTACT_EMAIL VARCHAR(50),\r

      RATING INT CHECK (RATING IN (1,2,3,4,5)),\r

      PHONE CHAR(12),\r

      PRIMARY KEY (SUPPLIER_ID)) ;\r

