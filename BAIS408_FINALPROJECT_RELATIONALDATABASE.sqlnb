    value: "-- 12. Create the Inventory Table\r

      CREATE TABLE INVENTORY\r

      (INVENTORY_ID INT NOT NULL ,\r

      PRODUCT_ID INT,\r

      WAREHOUSE_ID INT,\r

      QUANTITY_ON_HAND INT,\r

      REORDER_POINT INT,\r

      SAFETY_STOCK INT,\r

      PRIMARY KEY(INVENTORY_ID),\r

      FOREIGN KEY(WAREHOUSE_ID) REFERENCES WAREHOUSE(WAREHOUSE_ID),\r

      FOREIGN KEY(PRODUCT_ID) REFERENCES PRODUCT(PRODUCT_ID));\r

      -- Insert into Inventory Table\r

      insert into Inventory values(1,1,1,30,10,5);\r

      insert into Inventory values(2,2,2,23,10,5);\r

      insert into Inventory values(3,3,3,14,10,5);\r

      insert into Inventory values(4,4,4,43,10,5);\r

      insert into Inventory values(5,5,5,20,10,5);\r

      insert into Inventory values(6,6,6,22,10,5);\r

      insert into Inventory values(7,7,7,24,10,5);\r

