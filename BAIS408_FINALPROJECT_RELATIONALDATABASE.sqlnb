  - kind: 2
    value: "-- 14. Create the Review Table\r

      CREATE TABLE REVIEW\r

      (REVIEW_ID INT,\r

      PRODUCT_ID INT,\r

      CUSTOMER_ID INT,\r

      RATING INT CHECK (RATING IN (1,2,3,4,5)),\r

      REVIEW_TEXT VARCHAR(500),\r

      REVIEW_DATE DATE,\r

      PRIMARY KEY(REVIEW_ID),\r

      FOREIGN KEY(PRODUCT_ID) REFERENCES PRODUCT(PRODUCT_ID),\r

      FOREIGN KEY(CUSTOMER_ID) REFERENCES CUSTOMER(CUSTOMER_ID));\r

      -- Insert into Review Table\r

      insert into Review values(1,1,1,2,'Product arrived quickly and works
      great. The build quality feels
      premium',to_date('05/01/2024','mm/dd/yyyy'));\r

      insert into Review values(2,2,2,3,'Good performance, but the battery life
      could be better. Still a strong value
      overall',to_date('05/02/2024','mm/dd/yyyy'));\r

      insert into Review values(3,3,3,4,'Exceeded expectations. I use this every
      day for work and have not run into a single
      issue',to_date('05/03/2024','mm/dd/yyyy'));\r

      insert into Review values(5,5,5,1,'It is okay, but not as durable as I
      hoped. Might be better for light or casual
      use',to_date('05/05/2024','mm/dd/yyyy'));\r

      insert into Review values(6,6,6,2,'Loving the smooth setup and fast
      speeds. Great pick for anyone needing solid
      performance',to_date('05/06/2024','mm/dd/yyyy'));\r

      insert into Review values(8,8,8,4,'Decent features, but the price feels a
      little high. Customer support was helpful
      though',to_date('05/08/2024','mm/dd/yyyy'));\r

      insert into Review values(10,10,10,1,'Amazing device. Crisp display, fast
      response, and very comfortable to use
      daily',to_date('05/10/2024','mm/dd/yyyy'));\r

      insert into Review values(11,4,4,5,'Really impressed with the performance
      so far. Runs fast and handles everything I throw at
      it',to_date('05/11/2024','mm/dd/yyyy'));\r

      insert into Review values(12,7,7,3,'Comfortable to use, but I wish the
      keys felt a bit more solid for long typing
      sessions',to_date('05/12/2024','mm/dd/yyyy'));\r

      insert into Review values(13,9,9,4,'Reliable storage and easy to set up.
      Great for backups and extra game
      installs',to_date('05/13/2024','mm/dd/yyyy'));\r

      insert into Review values(14,11,11,5,'Incredible graphics performance.
      Games run smoother than I expected even at max
      settings',to_date('05/14/2024','mm/dd/yyyy'));\r

      insert into Review values(15,12,12,3,'Display quality is sharp, but I have
      noticed some minor backlight bleed in darker
      scenes',to_date('05/15/2024','mm/dd/yyyy'));\r

      insert into Review values(16,13,1,4,'Lightweight and portable, perfect for
      classes and coffee shops. Battery life has been
      solid',to_date('05/16/2024','mm/dd/yyyy'));\r

      insert into Review values(17,14,2,5,'Handles video editing and
      multitasking with no lag. Definitely worth the upgrade
      price',to_date('05/17/2024','mm/dd/yyyy'));\r

      insert into Review values(18,18,6,4,'The ultrawide screen makes
      productivity and gaming much more immersive and
      efficient',to_date('05/18/2024','mm/dd/yyyy'));\r

      insert into Review values(19,21,9,5,'Colors look fantastic and it is super
      smooth for both work and streaming
      content',to_date('05/19/2024','mm/dd/yyyy'));\r

      insert into Review values(20,20,8,2,'Good overall, but it runs a little
      warmer and louder than I expected under heavy
      use',to_date('05/20/2024','mm/dd/yyyy'));\r\n"
    languageId: oracle-sql
