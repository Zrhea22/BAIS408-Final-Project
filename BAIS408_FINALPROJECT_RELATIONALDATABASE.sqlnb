    value: "-- 8. Create the Orders Table\r

      CREATE TABLE ORDERS\r

      (ORDER_ID INT NOT NULL ,\r

      CUSTOMER_ID INT,\r

      SHIPPING_ADDRESS_ID INT,\r

      ORDER_DATE DATE,\r

      STATUS VARCHAR(20),\r

      SUBTOTAL_AMOUNT DECIMAL(10,2),\r

      PRIMARY KEY(ORDER_ID),\r

      FOREIGN KEY(CUSTOMER_ID) REFERENCES CUSTOMER(CUSTOMER_ID));\r

      -- Insert into Orders Table\r

