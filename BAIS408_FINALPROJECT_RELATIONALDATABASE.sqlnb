    value: "-- 5. Create the Brand Table\r

      CREATE TABLE BRAND\r

      (BRAND_ID INT NOT NULL,\r

      SUPPLIER_ID INT,\r

      BRAND_NAME VARCHAR(50),\r

      WEBSITE_URL VARCHAR(100),\r

      SUPPORT_PHONE CHAR(12),\r

      HQ_COUNTRY VARCHAR(30),\r

      PRIMARY KEY (BRAND_ID),\r

      FOREIGN KEY (SUPPLIER_ID) REFERENCES SUPPLIER(SUPPLIER_ID));\r

      -- Insert into Brand Table\r

      insert into Brand
      values(1,1,'Dell','https://www.dell.com/','800-624-9896','USA');\r

