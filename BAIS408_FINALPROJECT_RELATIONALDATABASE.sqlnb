  - kind: 2
    value: "-- 13. Create the Return Table\r

      CREATE TABLE RETURN\r

      (RETURN_ID INT,\r

      ORDER_ID INT,\r

      CUSTOMER_ID INT,\r

      STATUS VARCHAR(30),\r

      REFUND_AMOUNT DECIMAL(10,2),\r

      REASON_CODE VARCHAR(30),\r

      PRIMARY KEY(RETURN_ID),\r

      FOREIGN KEY(ORDER_ID) REFERENCES ORDERS(ORDER_ID),\r

      FOREIGN KEY(CUSTOMER_ID) REFERENCES CUSTOMER(CUSTOMER_ID));\r

      -- Insert into Return Table\r

      insert into Return values(1,1000,1,'Pending',1899.99,'OTHER');\r

      insert into Return values(2,1002,2,'Pending',1199,'DAMAGED');\r

